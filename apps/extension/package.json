{
  "name": "@lettercast/extension",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wxt build",
    "build:e2e": "wxt build --mode e2e",
    "dev": "wxt",
    "postinstall": "wxt prepare",
    "test": "vitest run && node ../../scripts/verify-service-worker-boundary.mjs && node ../../scripts/verify-content-identity-boundary.mjs && node ../../scripts/verify-content-script-boundary.mjs",
    "typecheck": "wxt prepare && tsc -p tsconfig.json --noEmit",
    "zip": "wxt zip"
  },
  "dependencies": {
    "@lettercast/contracts": "workspace:*"
  },
  "devDependencies": {
    "wxt": "0.21.4"
  }
}
