{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "lettercast-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-08",
  "env": {
    // This environment validates the binding configuration only. Its values
    // are Cloudflare's documented example, not approved production settings.
    // LC-013 must approve a unique production namespace and threshold before
    // account deployment.
    "rate-limit-validation": {
      "name": "lettercast-api-rate-limit-validation",
      "ratelimits": [
        {
          "name": "CAST_RATE_LIMITER",
          "namespace_id": "1001",
          "simple": {
            "limit": 100,
            "period": 60
          }
        }
      ]
    }
  }
}
