{
  "name": "@lettercast/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --env= --dry-run --outdir dist",
    "build:rate-limit-validation": "wrangler deploy --env rate-limit-validation --dry-run --outdir dist",
    "cf-typegen": "wrangler types src/worker-configuration.d.ts",
    "postinstall": "wrangler types src/worker-configuration.d.ts",
    "test": "vitest run && node ../../scripts/verify-rate-limit-key.mjs",
    "typecheck": "corepack pnpm cf-typegen && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@lettercast/contracts": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.1.5",
    "wrangler": "4.129.1"
  }
}
