{
  "name": "lettercast",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": "24.18.0",
    "pnpm": "12.3.4"
  },
  "scripts": {
    "build": "corepack pnpm -r --if-present build && node scripts/verify-manifest.mjs",
    "ci": "corepack pnpm lint && corepack pnpm typecheck && corepack pnpm test && corepack pnpm build && corepack pnpm security && corepack pnpm test:e2e",
    "lint": "eslint .",
    "release:extension": "corepack pnpm --filter @lettercast/extension zip",
    "release:verify": "node scripts/verify-release.mjs",
    "security": "node scripts/verify-security.mjs",
    "test": "corepack pnpm -r --if-present test",
    "test:e2e": "corepack pnpm --filter @lettercast/extension build:e2e && playwright test",
    "typecheck": "corepack pnpm -r --if-present typecheck && tsc -p tests/e2e/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "26.5.0",
    "eslint": "10.10.0",
    "jsdom": "30.0.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "4.1.11"
  }
}
